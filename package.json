{
  "name": "dany-score",
  "private": true,
  "version": "1.3.0",
  "description": "TakeFive — учебная геймификация",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run lint && npm run check:secrets && npm test",
    "lint": "eslint .",
    "test": "vitest run",
    "check:secrets": "node scripts/check-secrets.mjs",
    "backup:firestore": "node scripts/export-firestore.mjs",
    "probe:rules": "node scripts/probe-firestore-rules.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:import-firestore": "node scripts/import-firestore.mjs",
    "admin:hash-pin": "node scripts/hash-pin.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "firebase-admin": "^13.0.0",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
