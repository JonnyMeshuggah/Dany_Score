{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run check:*)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git branch)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create*)",
      "Bash(git worktree list*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm uninstall*)",
      "Bash(node scripts/*)",
      "Bash(npm run backup*)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(./.githooks/**)",
      "Edit(./opencode.json)",
      "Edit(./package.json)",
      "Edit(./api/**)",
      "WebFetch"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(vercel*)",
      "Bash(npx vercel*)",
      "Bash(firebase*)",
      "Bash(npx firebase*)",
      "Bash(npm publish*)",
      "Bash(rm -rf*)",
      "Read(./secrets/**)",
      "Read(./backups/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(**/*service-account*.json)",
      "Edit(./secrets/**)",
      "Edit(./backups/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "guard: проверка границ"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-file.mjs\"",
            "timeout": 60,
            "statusMessage": "eslint изменённого файла"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ]
    },
    "filesystem": {
      "allowWrite": ["~/.npm"],
      "denyRead": ["./secrets", "./backups", "./.env", "./.env.local", "./.env.production", "./.env.development"]
    }
  }
}
