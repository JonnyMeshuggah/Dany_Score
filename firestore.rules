rules_version = '2';

// Каждый пользователь видит и меняет только свой документ users/{uid}.
// Всё остальное (списки, чужие документы, другие коллекции) запрещено по умолчанию.
// Деплой правил делает человек: Firebase Console или `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
