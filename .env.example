# ==== Клиентский конфиг Firebase (отдаётся через /api/env) ====
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ==== Сервисный аккаунт Firebase (только для скриптов / сервера, НЕ коммитить) ====
# Путь к JSON-ключу: Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# ==== Neon Postgres (появится после подключения через Vercel Marketplace) ====
DATABASE_URL=

# ==== Админка ====
# Хэш PIN-кода админки (будет использоваться API на этапе 3)
ADMIN_PIN_HASH=
# Секрет для подписи админ-токенов
ADMIN_TOKEN_SECRET=
